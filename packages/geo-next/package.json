{
  "name": "@headless-geo/next",
  "version": "0.1.0",
  "description": "Frontend SDK for Headless GEO: Next.js proxy / middleware that reports AI crawler visits to your CMS.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@headless-geo/core": "0.1.0"
  },
  "module": "./dist/index.js"
}
