{
  "name": "@askbeam/next",
  "version": "0.5.1",
  "description": "Frontend SDK for Askbeam: Next.js proxy / middleware that reports AI crawler visits to your CMS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Askbeam/Askbeam.git",
    "directory": "packages/geo-next"
  },
  "homepage": "https://github.com/Askbeam/Askbeam#readme",
  "bugs": "https://github.com/Askbeam/Askbeam/issues",
  "keywords": [
    "geo",
    "generative-engine-optimization",
    "ai-seo",
    "llms.txt",
    "llms-txt",
    "ai-crawler",
    "ai-bots",
    "gptbot",
    "claudebot",
    "perplexity",
    "chatgpt",
    "nextjs",
    "next",
    "middleware",
    "proxy",
    "astro",
    "nuxt",
    "json-ld",
    "headless-cms",
    "askbeam"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@askbeam/core": "0.5.1"
  },
  "module": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  }
}
