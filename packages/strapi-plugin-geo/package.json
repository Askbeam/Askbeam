{
  "name": "@askbeam/strapi-plugin",
  "version": "0.5.2",
  "description": "Askbeam for Strapi 5: AI crawler logs, llms.txt and an AI visibility dashboard.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Askbeam/Askbeam.git",
    "directory": "packages/strapi-plugin-geo"
  },
  "homepage": "https://github.com/Askbeam/Askbeam#readme",
  "bugs": "https://github.com/Askbeam/Askbeam/issues",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "strapi5",
    "strapi-v5",
    "strapi-5",
    "geo",
    "generative-engine-optimization",
    "ai-seo",
    "llms.txt",
    "llms-txt",
    "ai-crawler",
    "ai-bots",
    "gptbot",
    "claudebot",
    "perplexity",
    "chatgpt",
    "json-ld",
    "analytics",
    "headless-cms",
    "askbeam"
  ],
  "type": "commonjs",
  "strapi": {
    "kind": "plugin",
    "name": "geo",
    "displayName": "Askbeam",
    "description": "AI crawler logs for headless sites."
  },
  "main": "./dist/server/index.js",
  "types": "./dist/server/index.d.ts",
  "exports": {
    "./strapi-admin": {
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/index.d.ts",
      "require": "./strapi-server.js",
      "default": "./strapi-server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "strapi-server.js",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@askbeam/core": "0.5.2",
    "@askbeam/dashboard": "0.5.2"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0"
  }
}
